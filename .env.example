NODE_ENV=development
PORT=3000
PG_POOL_MAX=10
# Keep false until you have verified actual supplier products and inventory.
SEED_SAMPLE_PRODUCTS=false
BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/zyvora
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=NGN
ENABLE_COD=false
# Create the first administrator account on first start when both values are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Marketplace commission charged on third-party seller item subtotals (0-50%).
PLATFORM_COMMISSION_PERCENT=10

# Cloudinary: required for persistent seller image uploads in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shipbubble courier API. Origin address code/category/dimensions come from your Shipbubble account.
SHIPBUBBLE_API_KEY=
SHIPBUBBLE_SENDER_ADDRESS_CODE=
SHIPBUBBLE_CATEGORY_ID=
SHIPBUBBLE_PACKAGE_LENGTH_CM=30
SHIPBUBBLE_PACKAGE_WIDTH_CM=20
SHIPBUBBLE_PACKAGE_HEIGHT_CM=10
SHIPBUBBLE_DEFAULT_ITEM_WEIGHT_KG=0.5

# Operational alerts: Slack-compatible incoming webhook URL (optional).
ALERT_WEBHOOK_URL=

# Encrypted database backups. Generate a key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# true is allowed only for local development and must never be used for production.
BACKUP_LOCAL_ONLY=true
# For production off-site S3-compatible storage (AWS S3, Cloudflare R2, etc.).
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=zyvora
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
